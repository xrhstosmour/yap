#!/usr/bin/env bash
set -euo pipefail

# Roll the server back to an earlier release.
# Usage: ./scripts/rollback.sh <user@host> [release] [options]
#
#   -p, --port PORT           SSH port, 22 by default
#   -i, --identity FILE       SSH private key
#       --list                show the releases that can be restored
#
# Runs the images of a release a past deploy.sh built and found healthy, the
# previous one when none is named, without building anything. The server keeps
# the last three.
#
# It swaps images only. The compose files, configuration and settings stay at
# the newest deploy and migrations the newer release ran stay applied, so roll
# back only when the older images still run on all of those, and restore a
# backup for anything else.

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_DIR"

# shellcheck source-path=SCRIPTDIR source=remote.sh
. "$PROJECT_DIR/scripts/remote.sh"

usage() {
    sed -n '4,9p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
}

TARGET="${1:-}"
[ -n "$TARGET" ] || usage
shift

RELEASE=""
LIST=0
SSH_PORT=22
IDENTITY=""
while [ $# -gt 0 ]; do
    case "$1" in
        -p|--port) SSH_PORT="$2"; shift 2 ;;
        -i|--identity) IDENTITY="$2"; shift 2 ;;
        --list) LIST=1; shift ;;
        -*) usage ;;
        *) RELEASE="$1"; shift ;;
    esac
done

REMOTE_DIRECTORY="{{ project_slug }}"
connect "$TARGET" "$SSH_PORT" "$IDENTITY"
[[ "$RELEASE" =~ ^[A-Za-z0-9._-]*$ ]] || error "$RELEASE is not a release."

if [ "$LIST" = 1 ]; then
    remote "cd $REMOTE_DIRECTORY && bash scripts/releases.sh list"
    exit 0
fi

info "Rolling $TARGET back${RELEASE:+ to $RELEASE}."
remote "cd $REMOTE_DIRECTORY && COMPOSE='$COMPOSE' bash scripts/releases.sh restore $RELEASE"
info "Rolled back. Migrations the newer release ran were not undone."
