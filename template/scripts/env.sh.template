#!/usr/bin/env bash
set -euo pipefail

# Read or change the settings on the server.
# Usage: ./scripts/env.sh <user@host> list | get KEY | set KEY [options]
#
#   -p, --port PORT           SSH port, 22 by default
#   -i, --identity FILE       SSH private key
#   -e, --environment FILE    local settings kept in step, .env.production by default
#
# `list` shows which settings are set, never their values. `set` reads the
# value from standard input, or asks for it without echoing, never from an
# argument that would stay in the shell history and the process list. It writes
# the value on the server and brings the stack up again to pick it up, and puts
# the previous settings back if the stack does not come up.
#
# deploy.sh writes the server's settings again from .env.production, so `set`
# changes that file too, or the next deploy would undo the value. A deploy
# from GitHub writes it from the ENV_PRODUCTION secret, update that as well.

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_DIR"

# shellcheck source-path=SCRIPTDIR source=remote.sh
. "$PROJECT_DIR/scripts/remote.sh"

usage() {
    sed -n '4,9p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
}

SSH_PORT=22
IDENTITY=""
ENVIRONMENT_FILE=".env.production"
ARGUMENTS=()
while [ $# -gt 0 ]; do
    case "$1" in
        -p|--port) SSH_PORT="$2"; shift 2 ;;
        -i|--identity) IDENTITY="$2"; shift 2 ;;
        -e|--environment) ENVIRONMENT_FILE="$2"; shift 2 ;;
        -*) usage ;;
        *) ARGUMENTS+=("$1"); shift ;;
    esac
done
TARGET="${ARGUMENTS[0]:-}"
ACTION="${ARGUMENTS[1]:-}"
KEY="${ARGUMENTS[2]:-}"
[ -n "$TARGET" ] && [ -n "$ACTION" ] || usage
[ -z "${ARGUMENTS[3]+given}" ] || usage

REMOTE_DIRECTORY="{{ project_slug }}"
connect "$TARGET" "$SSH_PORT" "$IDENTITY"
SERVER="cd $REMOTE_DIRECTORY && COMPOSE='$COMPOSE' bash scripts/environment.sh"

case "$ACTION" in
    list)
        remote "$SERVER list"
        ;;
    get|set)
        [[ "$KEY" =~ ^[A-Z][A-Z0-9_]*$ ]] || error "$KEY is not a setting name, use capitals and underscores."
        if [ "$ACTION" = get ]; then
            remote "$SERVER get $KEY"
        else
            # The prompt shows only on a terminal, a pipe is read as it is.
            IFS= read -rsp "Value for $KEY: " VALUE || true
            if [ -t 0 ]; then echo; fi
            [ -n "$VALUE" ] || error "No value for $KEY, give it on standard input or at the prompt."
            # On standard input, so it stays out of the server's process list.
            printf '%s\n' "$VALUE" | remote "$SERVER set $KEY"
            info "$KEY is set on $TARGET."
            # Deploys write the server's settings again from this file, so
            # the value has to be here as well or the next one undoes it.
            if [ -f "$ENVIRONMENT_FILE" ]; then
                set_value "$KEY" "$VALUE" "$ENVIRONMENT_FILE"
                info "$KEY is updated in $ENVIRONMENT_FILE too."
            else
                warn "No $ENVIRONMENT_FILE here, add $KEY to it or the next deploy undoes this."
            fi
            warn "A deploy from GitHub writes the settings from the ENV_PRODUCTION secret, update $KEY there too."
        fi
        ;;
    *) usage ;;
esac
