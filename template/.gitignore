# Byte-compiled/optimized/DLL files.
__pycache__/
*.py[cod]
*$py.class

# C extensions.
*.so

# Distribution/packaging.
build/
dist/
*.egg-info/
*.egg

# Environments.
.env
.env.local
.env.*.local
.venv/
venv/
ENV/

# Python
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp

# Testing
.coverage
.coverage.*
htmlcov/
.tox/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Keys
*.pem
*.key

# Generated dev TLS certificates and basic-auth secrets (recreated by setup.sh).
*.crt
*.csr
.htpasswd
.certificates

# Copier.
# Reconstructed at sync time from .env and project files.
# Must never be committed because it may contain secrets.
.copier/.answers.yml

# Celery beat local schedule database, written when beat runs locally.
celerybeat-schedule

# Database dumps written by scripts/backup.sh. Never committed: they are
# the entire database in plaintext, including every encrypted column's
# ciphertext and every password hash.
backups/
*.sql.gz
