        with self._simulate_denied():
            response = await client.post(
                "/api/v1/auth/register",
                json={
                    "email": "new@{{ project_slug }}.com",
                    "password": "password123",
                },
            )

        assert response.status_code == 429
        assert response.headers["retry-after"] == "30"

