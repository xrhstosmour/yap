class TestUsersCreate:
    """Tests for POST /api/v1/users.

    Regression coverage: UserService.create() raises UserServiceError
    (not a ValueError subclass) for a duplicate email. Catching only
    ValueError let it propagate uncaught, an unhandled 500 instead of the
    documented 400.
    """

    @pytest.mark.usefixtures("override_get_async_session")
    async def test_create_user_duplicate_email_returns_400(
        self, client: AsyncClient, session: AsyncSession
    ) -> None:
        auth_service = _auth_service(session)
        await auth_service.register(
            RegisterRequest(email="dupe-create@{{ project_slug }}.com", password="password123")
        )
        superuser = await _create_superuser(auth_service)
        token = create_access_token(subject=superuser.id)

        response = await client.post(
            "/api/v1/users",
            headers={"Authorization": f"Bearer {token}"},
            json={
                "email": "dupe-create@{{ project_slug }}.com",
                "full_name": "Duplicate",
                "password": "password123",
            },
        )

        assert response.status_code == 400
        assert "already in use" in response.json()["detail"]


class TestUsersUpdate:
    """Tests for PATCH /api/v1/users/{user_id}."""

    @pytest.mark.usefixtures("override_get_async_session")
    async def test_update_user(
        self, client: AsyncClient, session: AsyncSession
    ) -> None:
        """Update user should modify user data."""
        auth_service = _auth_service(session)
        target_user = await auth_service.register(
            RegisterRequest(email="user@{{ project_slug }}.com", password="password123")
        )
        superuser = await _create_superuser(auth_service)
        token = create_access_token(subject=superuser.id)

        response = await client.patch(
            f"/api/v1/users/{target_user.id}",
            headers={"Authorization": f"Bearer {token}"},
            json={"full_name": "Updated Name"},
        )

        assert response.status_code == 200
        data = response.json()
        assert data["full_name"] == "Updated Name"

    @pytest.mark.usefixtures("override_get_async_session")
    async def test_update_user_duplicate_email_returns_400(
        self, client: AsyncClient, session: AsyncSession
    ) -> None:
        """Regression: UserService.update() raises UserServiceError (not
        ValueError) for a duplicate email. Route previously had no
        exception handling at all around this call.
        """
        auth_service = _auth_service(session)
        await auth_service.register(
            RegisterRequest(email="dupe-existing@{{ project_slug }}.com", password="password123")
        )
        target_user = await auth_service.register(
            RegisterRequest(email="dupe-target@{{ project_slug }}.com", password="password123")
        )
        superuser = await _create_superuser(auth_service)
        token = create_access_token(subject=superuser.id)

        response = await client.patch(
            f"/api/v1/users/{target_user.id}",
            headers={"Authorization": f"Bearer {token}"},
            json={"email": "dupe-existing@{{ project_slug }}.com"},
        )

        assert response.status_code == 400
        assert "already in use" in response.json()["detail"]


