# Include-only compose file for infrastructure services.
# Core application services (app, celery-worker, celery-beat) are defined
# separately. Use `docker compose -f docker-compose.yml -f docker-compose.app.yml up`.

include:
  - containers/databases/postgresql/docker-compose.yml
  - containers/databases/redis/docker-compose.yml
  - containers/distribute/brokers/rabbitmq/docker-compose.yml
{%- if include_minio %}
  - containers/storage/minio/docker-compose.yml
{%- endif %}
{%- if include_traefik %}
  - containers/networking/proxies/traefik/docker-compose.yml
{%- endif %}
{%- if include_glitchtip %}
  - containers/monitoring/codebase/glitchtip/docker-compose.yml
{%- endif %}
{%- if include_metabase %}
  - containers/databases/manage/metabase/docker-compose.yml
{%- endif %}
{%- if include_pgadmin4 %}
  - containers/databases/manage/pgadmin4/docker-compose.yml
{%- endif %}
{%- if include_mailpit %}
  - containers/email/mailpit/docker-compose.yml
{%- endif %}
{%- if include_redis_commander %}
  - containers/databases/manage/redis_commander/docker-compose.yml
{%- endif %}
{%- if include_flower %}
  - containers/monitoring/workers/flower/docker-compose.yml
{%- endif %}
