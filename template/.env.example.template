# Application.
PROJECT_NAME="{{ project_name }}"
ENVIRONMENT=local
# Emitted whether or not Traefik is included. `scripts/synchronize.sh` reads
# the answers back out of this file, so a key that only appears under one
# option is silently reset to its default on every sync.
TIMEZONE={{ timezone }}

# Security.
SECRET_KEY={{ jwt_secret_key }}
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database.
POSTGRESQL_SERVER=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER={{ project_slug }}
POSTGRESQL_PASSWORD={{ postgresql_password }}
POSTGRESQL_DATABASE={{ project_slug }}
# Extra databases created on first initialization for companion services.
# The list includes databases for included services and any extra databases
# such as a demo/preview database.
POSTGRESQL_ADDITIONAL_DATABASES={% if include_glitchtip and include_metabase %}glitchtip,metabase{% elif include_glitchtip %}glitchtip{% elif include_metabase %}metabase{% endif %}{% if postgresql_extra_databases %}{% if include_glitchtip or include_metabase %},{% endif %}{{ postgresql_extra_databases }}{% endif %}
POSTGRESQL_AUTHENTICATION_METHOD=scram-sha-256
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600

# Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD={{ redis_password }}
REDIS_CLUSTER=false
REDIS_MAX_CONNECTIONS=50
REDIS_AOF_REWRITE_PERCENTAGE=100
REDIS_AOF_REWRITE_MINIMUM_SIZE=64mb
REDIS_MAXIMUM_MEMORY=256mb
REDIS_MAXIMUM_CLIENTS=10000

# RabbitMQ.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER={{ project_slug }}
RABBITMQ_PASSWORD={{ rabbitmq_password }}
RABBITMQ_ERLANG_COOKIE={{ rabbitmq_erlang_cookie }}
RABBITMQ_CONSUMER_TIMEOUT=36000000
{% if include_traefik %}
# Traefik.
TRAEFIK_PORT=8080
TRAEFIK_HOST={{ traefik_host }}
TRAEFIK_EMAIL={{ first_superuser_full_name|lower }}@{{ project_slug }}.com
TRAEFIK_CERTIFICATE_RESOLVER=
{% endif %}{% if include_flower %}
# Flower.
FLOWER_PORT=5555
FLOWER_USER={{ first_superuser_full_name|lower }}
FLOWER_PASSWORD={{ flower_password }}
{% endif %}{% if include_pgadmin4 %}
# pgAdmin4.
PGADMIN4_PORT=5050
PGADMIN4_EMAIL={{ first_superuser_full_name|lower }}@{{ project_slug }}.com
PGADMIN4_PASSWORD={{ pgadmin4_password }}
{% endif %}{% if include_metabase %}
# Metabase.
METABASE_PORT=3000
METABASE_DATABASE_TYPE=postgres
METABASE_DATABASE_NAME=metabase
METABASE_DATABASE_PORT=5432
METABASE_DATABASE_USER={{ project_slug }}
METABASE_DATABASE_PASSWORD={{ postgresql_password }}
METABASE_READ_ONLY_PASSWORD={{ metabase_read_only_password }}
{% endif %}{% if include_mailpit %}
# Mailpit.
MAILPIT_SMTP_PORT=1025
MAILPIT_PORT=8025
# MAILPIT_SMTP_AUTH_ACCEPT_ANY: Accept any SMTP authentication (DEV ONLY, set to false in production)
MAILPIT_SMTP_AUTH_ACCEPT_ANY=false
# MAILPIT_SMTP_AUTH_ALLOW_INSECURE: Allow insecure SMTP auth (DEV ONLY, set to false in production)
MAILPIT_SMTP_AUTH_ALLOW_INSECURE=false
# Web UI basic auth, format 'username:password'. Backfilled by setup.sh.
MAILPIT_UI_AUTH=
{% endif %}{% if include_redis_commander %}
# Redis Commander.
REDIS_COMMANDER_PORT=8082
REDIS_COMMANDER_USER={{ first_superuser_full_name|lower }}
REDIS_COMMANDER_PASSWORD={{ redis_commander_password }}
{% endif %}{% if include_minio %}
# MinIO.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_DEFAULT_BUCKET={{ project_slug }}-files
STORAGE_SECRET_KEY=
{% endif %}
STORAGE_REGION={{ storage_region }}
# Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@{{ project_slug }}.com
SMTP_USE_TLS=true

# Superuser.
FIRST_SUPERUSER_EMAIL={{ first_superuser_full_name|lower }}@{{ project_slug }}.com
FIRST_SUPERUSER_PASSWORD={{ first_superuser_password }}
FIRST_SUPERUSER_FULL_NAME={{ first_superuser_full_name }}

# CORS.
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Rate Limiting.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_MINUTE_API_KEY=300

# Encryption.
CRYPTO_KEY={{ crypto_key }}

# GlitchTip/Sentry.
# Set to your Sentry/GlitchTip DSN to enable error tracking
SENTRY_DSN=
{% if include_glitchtip %}
GLITCHTIP_PORT=8081
GLITCHTIP_SECRET_KEY={{ glitchtip_secret_key }}
DATABASE_URL=postgres://{{ project_slug }}:{{ postgresql_password }}@postgresql:5432/glitchtip
REDIS_URL=redis://:{{ redis_password }}@redis:6379/0
DEFAULT_FROM_EMAIL=noreply@{{ project_slug }}.com
ENABLE_USER_REGISTRATION=false
{% endif %}
# SSL Certificate Path.
SSL_CERTIFICATE_PATH=
