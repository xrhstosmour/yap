# Application.
PROJECT_NAME="{{ project_name }}"
ENVIRONMENT=local

# Security.
SECRET_KEY={{ jwt_secret_key }}
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database.
POSTGRESQL_SERVER=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER={{ project_slug }}
POSTGRESQL_PASSWORD={{ postgresql_password }}
POSTGRESQL_DATABASE={{ project_slug }}
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600

# Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_MAX_CONNECTIONS=50

# RabbitMQ.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER={{ project_slug }}
RABBITMQ_PASSWORD={{ rabbitmq_password }}

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@{{ project_slug }}.com
SMTP_USE_TLS=true

# Superuser.
FIRST_SUPERUSER_EMAIL=admin@{{ project_slug }}.com
FIRST_SUPERUSER_PASSWORD={{ first_superuser_password }}
FIRST_SUPERUSER_FULL_NAME={{ first_superuser_full_name }}

# CORS.
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173

# Rate Limiting.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_MINUTE_API_KEY=300

# Encryption.
CRYPTO_KEY={{ crypto_key }}

# Monitoring.
SENTRY_DSN={{ sentry_dsn }}
