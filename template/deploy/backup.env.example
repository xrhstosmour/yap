# Where off-box backups go, and the key that encrypts them. Copy to
# deploy/backup.env, which is ignored by git, and replace every value.
#
# Keep a copy of RESTIC_PASSWORD somewhere that is not this machine. The
# repository cannot be read without it, so losing the box and the password
# together loses every backup.

# Any repository restic supports. Two common ones:
#
# An S3-compatible bucket.
#   RESTIC_REPOSITORY=s3:https://object-storage.example.com/bucket-name/restic
#   AWS_ACCESS_KEY_ID=replace-with-access-key
#   AWS_SECRET_ACCESS_KEY=replace-with-secret-key
#
# An SFTP host, such as a storage box. Put the private key and a
# known_hosts line for the host in deploy/ssh/, as id_ed25519 and
# known_hosts, which the scripts mount into the restic container.
#   RESTIC_REPOSITORY=sftp:user@backup.example.com:restic
RESTIC_REPOSITORY=replace-with-repository
RESTIC_PASSWORD=replace-with-a-long-random-password
