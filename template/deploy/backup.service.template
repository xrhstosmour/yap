# Runs scripts/offsite_backup.sh once. Started nightly by backup.timer.
#
# A user unit of the login user that deploys, the one `scripts/deploy.sh`
# copies the project to `~/{{ project_slug }}` for and that runs Docker,
# rootless or through the docker group. Install with:
#   mkdir -p ~/.config/systemd/user
#   cp ~/{{ project_slug }}/deploy/backup.service ~/{{ project_slug }}/deploy/backup.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now backup.timer
# The timer fires without anyone logged in only when the user lingers,
# which a sudoer turns on once with `sudo loginctl enable-linger <user>`.
# A failed run shows in `systemctl --user status backup.service` and in
# `journalctl --user -u backup.service`.

[Unit]
Description={{ project_name }} off-box backup
# The user's rootless daemon, when there is one.
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/{{ project_slug }}
ExecStart=%h/{{ project_slug }}/scripts/offsite_backup.sh
