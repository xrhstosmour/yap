# Runs scripts/offsite_backup.sh once. Started nightly by backup.timer.
#
# Assumes the project is checked out at /opt/{{ project_slug }}. Install with:
#   sudo cp deploy/backup.service deploy/backup.timer /etc/systemd/system/
#   sudo systemctl enable --now backup.timer
# A failed run shows in `systemctl status backup.service` and the journal.

[Unit]
Description={{ project_name }} off-box backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/{{ project_slug }}
ExecStart=/opt/{{ project_slug }}/scripts/offsite_backup.sh
