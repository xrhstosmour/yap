name: Backend CI

permissions:
  contents: read

on:
  push:
    branches: [main]
{% if nested %}
    paths: ['{{ _folder_name }}/**', '.github/workflows/**']
{% endif %}
  pull_request:
    branches: [main]
{% if nested %}
    paths: ['{{ _folder_name }}/**', '.github/workflows/**']
{% endif %}

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  lint:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: {% if nested %}{{ _folder_name }}{% else %}.{% endif %}
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - run: uv sync --extra dev
      - run: uv run ruff check app/ tests/
      - run: uv run ruff format --check app/ tests/
      - run: uv run mypy app/ --config-file mypy-ci.toml
      - name: Check single Alembic head
        run: |
          uv run python -c "
          import re
          from pathlib import Path

          versions = Path('migrations/versions')
          revisions = {}
          for migration in versions.glob('*.py'):
              content = migration.read_text()
              rev_match = re.search(
                  r'^revision:\s*str\s*=\s*\"([^\"]+)\"', content, re.MULTILINE
              )
              down_match = re.search(
                  r'^down_revision.*=\s*\"([^\"]+)\"\s*$', content, re.MULTILINE
              )
              if rev_match:
                  rev = rev_match.group(1)
                  parent = down_match.group(1) if down_match else None
                  revisions[rev] = parent

          heads = set(revisions.keys()) - {p for p in revisions.values() if p}
          assert len(heads) == 1, \
              f'Expected 1 Alembic head, got {len(heads)}: {heads}'
          print(f'Single Alembic head: {next(iter(heads))}')
          "

  test:
    needs: lint
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: {% if nested %}{{ _folder_name }}{% else %}.{% endif %}
    services:
      postgresql:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: app
          POSTGRES_PASSWORD: testpass
          POSTGRES_DB: testdb
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 5s
          --health-timeout 5s
          --health-retries 5
      redis:
        image: redis:7-alpine
        ports:
          - 6379:6379
        options: >-
          --health-cmd "redis-cli -a testpass ping"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 5
        command: redis-server --requirepass testpass
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - name: Generate secrets
        run: |
          cp .env.example .env
          python3 -c "
          import os
          with open('.env.example') as f:
              for line in f:
                  line = line.strip()
                  if not line or line.startswith('#'):
                      continue
                  if '=' not in line:
                      continue
                  key, _, value = line.partition('=')
                  value = value.strip().strip('\"').strip(\"'\")
                  with open(os.environ['GITHUB_ENV'], 'a') as out:
                      out.write(f'{key}={value}\n')
          "
          echo "SECRET_KEY=$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')" >> $GITHUB_ENV
          echo "CRYPTO_KEY=$(python3 -c 'import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())')" >> $GITHUB_ENV
          echo "RABBITMQ_PASSWORD=$(python3 -c 'import secrets; print(secrets.token_urlsafe(16))')" >> $GITHUB_ENV
          echo "FIRST_SUPERUSER_PASSWORD=$(python3 -c 'import secrets; print(secrets.token_urlsafe(16))')" >> $GITHUB_ENV
      - run: uv sync --extra dev
      - run: uv run alembic upgrade head
        env:
          POSTGRESQL_SERVER: localhost
          POSTGRESQL_HOST: localhost
          POSTGRESQL_PORT: 5432
          POSTGRESQL_USER: app
          POSTGRESQL_PASSWORD: testpass
          POSTGRESQL_DATABASE: testdb
          REDIS_HOST: localhost
          REDIS_PORT: 6379
          REDIS_PASSWORD: testpass
          ENVIRONMENT: local
          POSTGRESQL_AUTHENTICATION_METHOD: password
      - run: uv run python -m app.initial_data
        env:
          POSTGRESQL_SERVER: localhost
          POSTGRESQL_HOST: localhost
          POSTGRESQL_PORT: 5432
          POSTGRESQL_USER: app
          POSTGRESQL_PASSWORD: testpass
          POSTGRESQL_DATABASE: testdb
          REDIS_HOST: localhost
          REDIS_PORT: 6379
          REDIS_PASSWORD: testpass
          ENVIRONMENT: local
          POSTGRESQL_AUTHENTICATION_METHOD: password
      - run: uv run pytest tests/ -v --tb=short --cov=app --cov-report=xml
        env:
          POSTGRESQL_SERVER: localhost
          POSTGRESQL_HOST: localhost
          POSTGRESQL_PORT: 5432
          POSTGRESQL_USER: app
          POSTGRESQL_PASSWORD: testpass
          POSTGRESQL_DATABASE: testdb
          REDIS_HOST: localhost
          REDIS_PORT: 6379
          REDIS_PASSWORD: testpass
          ENVIRONMENT: local
          POSTGRESQL_AUTHENTICATION_METHOD: password
      - name: Enforce coverage threshold
        run: uv run coverage report
      - name: Run smoke test
        run: uv run pytest tests/test_startup.py::test_api_smoke -v --tb=short
        env:
          POSTGRESQL_SERVER: localhost
          POSTGRESQL_HOST: localhost
          POSTGRESQL_PORT: 5432
          POSTGRESQL_USER: app
          POSTGRESQL_PASSWORD: testpass
          POSTGRESQL_DATABASE: testdb
          REDIS_HOST: localhost
          REDIS_PORT: 6379
          REDIS_PASSWORD: testpass
          ENVIRONMENT: local
          POSTGRESQL_AUTHENTICATION_METHOD: password
      - uses: codecov/codecov-action@v5
        if: github.event_name == 'pull_request'
        with:
          files: {% if nested %}./{{ _folder_name }}/coverage.xml{% else %}./coverage.xml{% endif %}

  security:
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Run Trivy vulnerability scanner
        uses: aquasecurity/trivy-action@v0.36.0
        with:
          scan-type: fs
          scan-ref: {% if nested %}{{ _folder_name }}{% else %}.{% endif %}
          severity: CRITICAL,HIGH
          exit-code: 1
      - name: Report medium-severity findings
        uses: aquasecurity/trivy-action@v0.36.0
        with:
          scan-type: fs
          scan-ref: {% if nested %}{{ _folder_name }}{% else %}.{% endif %}
          severity: MEDIUM
          exit-code: 0
