[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">=3.14"
authors = [
    {name = "{{ author_name }}", email = "{{ author_email }}"}
]

dependencies = [
    "fastapi[standard]>=0.141.1",
    # The JSON encoder every response uses. Not in the `standard`
    # extra, so it is named here rather than assumed present.
    "orjson>=3.10.0",
    "sqlmodel>=0.0.22",
    "greenlet>=3.1.1",
    "pydantic-settings>=2.6.0",
    "psycopg[binary]>=3.2.0",
    # 2.14.0 is the first release without CVE-2026-102266, an
    # authentication bypass where an empty HMAC key verifies, and the
    # token-forgery issues alongside it. This is the library that checks
    # every access token, so the floor is the fixed version rather than
    # the oldest one that works.
    "PyJWT[crypto]>=2.14.0",
    "pwdlib[argon2,bcrypt]>=0.3.0",
    "alembic>=1.14.0",
    "tenacity>=9.0.0",
    "structlog>=25.0.0",
    "redis>=5.2.0",
    "celery>=5.4.0",
{%- if include_redbeat %}
    "celery-redbeat>=2.3.0",
{%- endif %}
    "email-validator>=2.2.0",
    "phonenumbers>=8.13.0",
    # The http2 extra is for APNs, which refuses HTTP/1.1 outright.
    "httpx[http2]>=0.28.0",
    "jinja2>=3.1.0",
    "pyotp>=2.9.0",
    "qrcode[pil]>=8.0",
    "webauthn>=2.8.0",
    "boto3>=1.35.0",
    "Pillow>=10.0.0",
    "pybreaker>=0.8.0",
    "opentelemetry-api>=1.27.0",
    "opentelemetry-sdk>=1.27.0",
    "amqp>=5.3.0",
    "sentry-sdk>=2.0.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.3.0",
    "pytest-asyncio>=0.25.0",
    "pytest-cov>=6.0.0",
    "pytest-xdist>=3.6.0",
    "httpx>=0.28.0",
    "mypy>=1.14.0",
    "ruff>=0.8.0",
    "pre-commit>=4.0.0",
    "celery[redis]>=5.4.0",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["app"]

[tool.mypy]
python_version = "3.14"
strict = true
exclude = ["venv", ".venv", "migrations/versions"]

[[tool.mypy.overrides]]
module = [
    "redis.*",
    "celery.*",
    "sentry_sdk.*",
    "pyotp.*",
    "qrcode.*",
    "PIL.*",
    "webauthn.*",
    "boto3.*",
    "botocore.*",
    "pybreaker.*",
    "phonenumbers.*",
]
ignore_missing_imports = true

[tool.ruff]
# Pinned below the project's actual py314 minimum: ruff's formatter has an
# open bug where target-version "py314" rewrites `except (A, B):` into the
# unparenthesized PEP 758 form, which several ruff releases then emit
# inconsistently. Revert to "py314" once astral-sh/ruff#23090 is fixed.
target-version = "py313"
exclude = ["venv", ".venv", "migrations/versions"]

[tool.ruff.lint]
select = [
    "E",   # pycodestyle errors
    "W",   # pycodestyle warnings
    "F",   # pyflakes
    "I",   # isort
    "B",   # flake8-bugbear
    "C4",  # flake8-comprehensions
    "UP",  # pyupgrade
    "T201", # print statements
    "ANN", # annotations
]
ignore = [
    "E501",  # line too long
    "B904",  # raise from - let HTTPExceptions pass through
    "ANN001",  # missing type for self in bound tasks
    "ANN002", # missing type for *args
    "ANN003", # missing type for **kwargs
    "ANN201", # missing return type on public functions
    "ANN202", # missing return type on private functions
    "ANN204", # missing return type for __call__
    "ANN401", # Any types in function signatures
]

[tool.ruff.lint.isort]
force-single-line = true
known-first-party = ["app"]

[tool.ruff.format]
quote-style = "double"
line-ending = "lf"

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
python_files = ["test_*.py"]
addopts = "-v --tb=short -n auto"
markers = [
    "slow: requires running services; deselect with '-m \"not slow\"'",
]
# A tenant filter names one model's `tenant_id`. Applied to a query over a
# different table, PostgreSQL has to bring the filtered table into the FROM
# with no join condition, and the result is a cross join: counts come back
# multiplied, and the table that was actually selected is left unscoped. It
# is silent, the rows look plausible, and tests that assert on one row pass.
# SQLAlchemy sees it every time, so the warning is the gate.
filterwarnings = [
    "error:SELECT statement has a cartesian product:sqlalchemy.exc.SAWarning",
]

[tool.coverage.run]
source = ["app"]
branch = true

[tool.coverage.report]
fail_under = 82
show_missing = true
exclude_lines = [
    "pragma: no cover",
    "def __repr__",
    "raise NotImplementedError",
    "if __name__ == .__main__.:",
]
