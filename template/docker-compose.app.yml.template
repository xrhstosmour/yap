# Core application services, layered on top of the infrastructure services
# that docker-compose.yml includes from the containers repository.
#
# Usage:
#   docker compose -f docker-compose.yml -f docker-compose.app.yml up
#
# The network is named after the project, and owned by it, so two projects
# generated from this template can run side by side. The vendored compose
# files under containers/ are rewritten to match by scripts/assemble.py.
# Compose creates it, so there is no `docker network create` step.

networks:
  internal:
    name: "{{ project_slug }}-internal"

{%- if not include_redbeat %}

volumes:
  celery-beat-schedule:
    name: "{{ project_slug }}-celery-beat-schedule"
{%- endif %}

services:
  app:
    build:
      context: "."
    container_name: "{{ project_slug }}-app"
    restart: "unless-stopped"
    env_file:
      - ".env"
    environment:
      # The defaults in .env point at localhost, which resolves to the
      # container itself once the app runs inside compose.
      - "POSTGRESQL_SERVER=postgresql"
      - "REDIS_HOST=redis"
      - "RABBITMQ_HOST=rabbitmq"
      # Which peers may set X-Forwarded-For. `uvicorn` reads this variable
      # and defaults it to 127.0.0.1, but the reverse proxy is a separate
      # container, so its address never matches and the header is ignored:
      # `request.client.host` becomes the proxy's own IP for every request.
      # That makes the per-IP limiter on the unauthenticated auth endpoints
      # a single bucket for the entire internet, and puts one address in
      # every access and audit log line.
      #
      # Scoped to Docker's private bridge range rather than `*`. `*` trusts
      # the header from anyone who can open a socket to this container, and
      # port 8000 is published, so a client reaching it directly could
      # forge any address and sidestep rate limiting entirely.
      # Loopback is kept alongside it so a proxy on the host still works.
      - "FORWARDED_ALLOW_IPS=${FORWARDED_ALLOW_IPS:-127.0.0.1,172.16.0.0/12}"
    ports:
      - "8000:8000"
    networks:
      - "internal"
    depends_on:
      postgresql:
        condition: "service_healthy"
      redis:
        condition: "service_healthy"
      rabbitmq:
        condition: "service_healthy"

  celery-worker:
    build:
      context: "."
    container_name: "{{ project_slug }}-celery-worker"
    restart: "unless-stopped"
    command: ["celery", "-A", "app.celery_app", "worker", "--loglevel=info"]
    env_file:
      - ".env"
    environment:
      - "POSTGRESQL_SERVER=postgresql"
      - "REDIS_HOST=redis"
      - "RABBITMQ_HOST=rabbitmq"
    networks:
      - "internal"
    depends_on:
      postgresql:
        condition: "service_healthy"
      redis:
        condition: "service_healthy"
      rabbitmq:
        condition: "service_healthy"

  celery-beat:
    build:
      context: "."
    container_name: "{{ project_slug }}-celery-beat"
    restart: "unless-stopped"
{%- if include_redbeat %}
    command: ["celery", "-A", "app.celery_app", "beat", "-S", "redbeat.RedBeatScheduler", "-l", "info"]
{%- else %}
    # `--schedule` is explicit because the default writes `celerybeat-schedule`
    # into the working directory, and `/app` is root-owned while the container
    # runs as `appuser`. Beat died on startup with
    # `PermissionError: [Errno 13] Permission denied: 'celerybeat-schedule'`,
    # so no periodic task ever ran. The volume keeps the schedule across
    # restarts, which is the point of the persistent scheduler.
    command: ["celery", "-A", "app.celery_app", "beat", "--loglevel=info", "--schedule", "/var/lib/celery/celerybeat-schedule"]
    volumes:
      - "celery-beat-schedule:/var/lib/celery"
{%- endif %}
    env_file:
      - ".env"
    environment:
      - "POSTGRESQL_SERVER=postgresql"
      - "REDIS_HOST=redis"
      - "RABBITMQ_HOST=rabbitmq"
    networks:
      - "internal"
    depends_on:
      postgresql:
        condition: "service_healthy"
      redis:
        condition: "service_healthy"
      rabbitmq:
        condition: "service_healthy"
